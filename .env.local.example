# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get from: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Anthropic / Claude ───────────────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ─── Airtable (seed data / migration only) ───────────────────────────────────
# Get from: https://airtable.com/account → API
AIRTABLE_TOKEN=your-airtable-personal-access-token
AIRTABLE_BASE_ID=your-airtable-base-id

# ─── MailerLite ───────────────────────────────────────────────────────────────
# Get from: https://app.mailerlite.com → Integrations → API → Generate token
MAILERLITE_API_KEY=your-mailerlite-api-key-here
